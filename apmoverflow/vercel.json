{
  "buildCommand": "node scripts/generate-feed.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/feed",
      "has": [{ "type": "query", "key": "type", "value": "rss" }],
      "destination": "/feed/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed/",
      "has": [{ "type": "query", "key": "type", "value": "rss" }],
      "destination": "/feed/rss.xml",
      "permanent": true
    },
    {
      "source": "/on-agent-memory-fidelity-decant/",
      "destination": "/on-agent-memory-fidelity/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feed/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/feed/index.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/feed/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ]
}
